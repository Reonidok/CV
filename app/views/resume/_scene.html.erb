<%# Pixel scene: sun, character at a Mac with coffee, sakura branch, falling petals. %>
<div class="rk-scene">
  <div class="rk-scene__rays"></div>
  <div class="rk-scene__sun"></div>
  <div class="rk-scene__char"><%= character_sprite %></div>
  <div class="rk-scene__ground">
    <div><%= mac_sprite %></div>
    <div class="rk-scene__cup"><%= cup_sprite %></div>
  </div>
  <div class="rk-scene__sakura"><%= sakura_branch %></div>
  <div class="rk-petals">
    <span class="rk-petal" style="left:24%;width:11px;height:9px;background:#f4a9c4;animation:petalfall 5.5s linear infinite;animation-delay:0s;"></span>
    <span class="rk-petal" style="left:58%;width:9px;height:7px;background:#f8c9da;animation:petalfall 7s linear infinite;animation-delay:1.4s;"></span>
    <span class="rk-petal" style="left:78%;width:11px;height:9px;background:#f4a9c4;animation:petalfall 6.2s linear infinite;animation-delay:2.6s;"></span>
    <span class="rk-petal" style="left:42%;width:8px;height:6px;background:#f8c9da;animation:petalfall 8s linear infinite;animation-delay:3.8s;"></span>
  </div>
</div>
