<div class="rk-landscape">
  <div class="rk-landscape__label"><%= landscape.label %></div>
  <div class="rk-landscape__sun"></div>
  <div class="rk-landscape__fuji"><%= fuji_sprite %></div>
  <div class="rk-landscape__pagoda"><%= pagoda_sprite %></div>
  <div class="rk-landscape__ground"></div>
  <div class="rk-landscape__grass"></div>
  <div class="rk-landscape__sakura"><%= sakura_branch %></div>
  <div class="rk-landscape__petals">
    <span class="rk-petal" style="left:14%;width:11px;height:9px;background:#f4a9c4;animation:petalfall2 6s linear infinite;animation-delay:.4s;"></span>
    <span class="rk-petal" style="left:34%;width:9px;height:7px;background:#f8c9da;animation:petalfall2 7.4s linear infinite;animation-delay:2s;"></span>
    <span class="rk-petal" style="left:62%;width:11px;height:9px;background:#f4a9c4;animation:petalfall2 6.6s linear infinite;animation-delay:3.2s;"></span>
    <span class="rk-petal" style="left:84%;width:8px;height:6px;background:#f8c9da;animation:petalfall2 8.2s linear infinite;animation-delay:1.1s;"></span>
  </div>
</div>
